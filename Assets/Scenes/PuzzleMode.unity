    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[0].text
      value: "\u6B22\u8FCE\u6765\u5230\u4E00\u7247\u6F06\u9ED1\u7684\u4E16\u754C"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[1].text
      value: "\u6309\u4E0B\u7A7A\u683C\u53D1\u51FA\u58F0\u6CE2\n\u89C2\u5BDF\u5468\u56F4\u73AF\u5883"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[2].text
      value: "\u4F60\u4F1A\u53D1\u73B0\u8FD9\u4E9B\u7EBF\u6761\u5728\u5899\u58C1\u4E0A\u53CD\u5F39\n\u5B83\u4EEC\u4F1A\u63ED\u793A\u901A\u8DEF\u7684\u8F6E\u5ED3"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[3].text
      value: "\u7EE7\u7EED\u6309\u7A7A\u683C\uFF0C\u540C\u65F6\u79FB\u52A8\u9F20\u6807\u6765\u8F6C\u52A8\u955C\u5934"
