        type: 3}
      propertyPath: entries.Array.data[2].text
      value: "\u6211\u5EFA\u8BAE\u4F60\u5728\u8FDB\u5165\u8FD9\u79CD\u7A7A\u65F7\u5730\u533A\u6216\u5C94\u8DEF\u524D\u653E\u7F6E\u4E00\u4E2A\u6807\u8BB0\uFF0C\u4EE5\u514D\u8FF7\u8DEF"
