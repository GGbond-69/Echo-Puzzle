        type: 3}
      propertyPath: entries.Array.data[7].text
      value: "\u6309W\u3001A\u3001S\u3001D\u952E\u6765\u79FB\u52A8\u89D2\u8272\n\u6309\u4F4FShift\u51B2\u523A\n\u6309\u4F4FCtrl\u6F5C\u884C"
