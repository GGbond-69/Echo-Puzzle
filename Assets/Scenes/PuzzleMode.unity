        type: 3}
      propertyPath: entries.Array.data[4].text
      value: "\u4ECE\u591A\u4E2A\u89D2\u5EA6\u6765\u89C2\u5BDF\u6709\u5229\u4E8E\u4F60\u8FDB\u884C\u7A7A\u95F4\u60F3\u8C61"
