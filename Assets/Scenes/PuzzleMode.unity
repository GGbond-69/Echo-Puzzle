        type: 3}
      propertyPath: entries.Array.data[0].text
      value: "\u4F60\u9762\u524D\u662F\u4E00\u4E2A\u62E5\u6709\u5706\u5F62\u7A79\u9876\u7684\u623F\u95F4\uFF0C\u4F60\u53EF\u4EE5\u89C2\u5BDF\u4E00\u4E0B\u5934\u9876\u7684\u7EBF\u6761\u662F\u5982\u4F55\u53CD\u5C04\u7684"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[1].text
      value: "\u6309\u6570\u5B57\u952E1\u52305\u53EF\u4EE5\u653E\u4E0B\u6807\u8BB0\n\u6BCF\u4E2A\u6570\u5B57\u952E\u5355\u72EC\u5BF9\u5E94\u4E00\u4E2A\u6807\u8BB0"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[2].text
      value: "\u5EFA\u8BAE\u4F60\u5728\u8FDB\u5165\u7A7A\u65F7\u5730\u533A\u6216\u5C94\u8DEF\u524D\u653E\u7F6E\u4E00\u4E2A\u6807\u8BB0\uFF0C\u4EE5\u514D\u8FF7\u8DEF"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[3].text
      value: "\u5C1D\u8BD5\u627E\u5230\u51FA\u53E3"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[4].text
      value: "\u4ECE\u591A\u4E2A\u89D2\u5EA6\u6765\u89C2\u5BDF\u53EF\u4EE5\u5E2E\u4F60\u66F4\u597D\u5730\u770B\u6E05\u9053\u8DEF"
      objectReference: {fileID: 0}
    - target: {fileID: 6758806939377316728, guid: b1c73b945c47e44499f0af3ed26e9e7e,
        type: 3}
      propertyPath: entries.Array.data[5].text
      value: "\u8BD5\u7740\u7F29\u653E\u6EDA\u8F6E\u6765\u8C03\u6574\u955C\u5934\u8DDD\u79BB"
      objectReference: {fileID: 0}
