        type: 3}
      propertyPath: entries.Array.data[6].text
      value: "\u5EFA\u8BAE\u4F60\u5C06\u8DDD\u79BB\u8C03\u6574\u81F3\u6700\u8FDC\uFF0C\u5E76\u79FB\u52A8\u81F3\u4FEF\u77B0\u89C6\u89D2\uFF0C\u8FD9\u6709\u5229\u4E8E\u4F60\u611F\u53D7\u5730\u56FE"
